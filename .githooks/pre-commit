#!/usr/bin/env sh
# CardMind pre-commit 钩子（薄启动器）
# 业务逻辑全部在 tool/git_gate.mjs；本文件只负责：
#   1) 兼容 SKIP_LOCAL_CHECK=1 跳过
#   2) 定位仓库根
#   3) exec node tool/git_gate.mjs pre-commit
# 跳过方式（谨慎使用）:
#   SKIP_LOCAL_CHECK=1 git commit
if [ "${SKIP_LOCAL_CHECK:-0}" = "1" ]; then
  echo "[pre-commit] SKIP_LOCAL_CHECK=1，跳过本地质量门禁"
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
# 不按 pubspec.yaml 存在性短路：4.6 起仓库不再有 pubspec.yaml（Flutter 链已删），
# 旧短路会让本地门禁整体空转。
if ! command -v node >/dev/null 2>&1; then
  echo "[pre-commit] 未找到 node 命令，无法执行本地质量门禁；请将 Node.js 加入 PATH" >&2
  exit 1
fi

cd "$repo_root" || exit 1
exec node tool/git_gate.mjs pre-commit
