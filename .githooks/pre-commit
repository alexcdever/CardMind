#!/usr/bin/env bash
# CardMind pre-commit 钩子：本地质量闸门
# 每次 git commit 自动执行 scripts/check.sh，任何检查失败阻止提交。
# 跳过方式（谨慎使用）:
#   SKIP_LOCAL_CHECK=1 git commit
#   或 git commit --no-verify
if [ "${SKIP_LOCAL_CHECK:-0}" = "1" ]; then
  echo "[pre-commit] SKIP_LOCAL_CHECK=1，跳过本地检查"
  exit 0
fi

# 只对 CardMind 仓库生效（防止误装到别的仓库）
if [ ! -f "$(dirname "$0")/../pubspec.yaml" ]; then
  exit 0
fi

# 纯文档提交跳过全量检查：本次暂存的文件全部是 .md 时不跑测试
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged_files" ]; then
  non_doc=$(printf '%s\n' "$staged_files" | grep -v '\.md$' || true)
  if [ -z "$non_doc" ]; then
    echo "[pre-commit] 本次提交仅含文档（.md），跳过质量检查"
    exit 0
  fi
fi

"$(dirname "$0")/../scripts/check.sh"
