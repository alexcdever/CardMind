#!/usr/bin/env sh
# CardMind pre-push 钩子（薄启动器）
# 业务逻辑全部在 tool/git_gate.dart；本文件只负责：
#   1) 兼容 SKIP_LOCAL_CHECK=1 跳过
#   2) 定位仓库根
#   3) exec dart run tool/git_gate.dart pre-push（stdin ref 行原样传给 Dart 进程）
# 跳过方式（谨慎使用）:
#   SKIP_LOCAL_CHECK=1 git push
if [ "${SKIP_LOCAL_CHECK:-0}" = "1" ]; then
  echo "[pre-push] SKIP_LOCAL_CHECK=1，跳过本地质量门禁"
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
if [ ! -f "$repo_root/pubspec.yaml" ]; then
  exit 0
fi
if ! command -v dart >/dev/null 2>&1; then
  echo "[pre-push] 未找到 dart 命令，无法执行本地质量门禁；请将 Dart/Flutter 加入 PATH" >&2
  exit 1
fi

cd "$repo_root" || exit 1
exec dart run tool/git_gate.dart pre-push
